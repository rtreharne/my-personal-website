---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Dr. Robert Treharne | Academic Profile',
	description = 'Academic profile, education, and teaching information for Dr. Robert Treharne.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap"
			rel="stylesheet"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<script is:inline>
			try {
				const savedContrast = localStorage.getItem('contrast-mode');
				const prefersContrast = window.matchMedia('(prefers-contrast: more)').matches;
				if (savedContrast === 'high' || (savedContrast === null && prefersContrast)) {
					document.documentElement.dataset.contrast = 'high';
				}
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light;
		--paper: #f4f2ea;
		--paper-raised: #fffefa;
		--ink: #202927;
		--muted: #58635f;
		--rule: #bbc4bd;
		--signal: #bd4f31;
		--signal-ink: #87351f;
		--night: #1a2725;
		--serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;
		--mono: 'DM Mono', 'SFMono-Regular', Consolas, monospace;
	}

	:root[data-contrast='high'] {
		color-scheme: light;
		--paper: #fff;
		--paper-raised: #fff;
		--ink: #000;
		--muted: #171717;
		--rule: #000;
		--signal: #000;
		--signal-ink: #000;
		--night: #000;
	}

	* {
		box-sizing: border-box;
	}

	html {
		background: var(--paper);
		scroll-behavior: smooth;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: var(--ink);
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.65;
		transition: background-color 180ms ease, color 180ms ease;
	}

	a {
		color: var(--signal-ink);
	}

	:focus-visible {
		outline: 3px solid var(--signal);
		outline-offset: 4px;
	}

	.skip-link {
		position: fixed;
		top: 8px;
		left: 8px;
		z-index: 10;
		padding: 8px 12px;
		transform: translateY(-160%);
		background: var(--ink);
		color: var(--paper-raised);
	}

	.skip-link:focus {
		transform: translateY(0);
	}

	::selection {
		background: var(--signal);
		color: white;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			scroll-behavior: auto !important;
			transition-duration: 0.01ms !important;
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
		}
	}
</style>
